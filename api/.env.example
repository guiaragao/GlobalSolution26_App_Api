# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
PORT=3000

# Gere um segredo longo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Oracle (FIAP: oracle.fiap.com.br:1521/ORCL)
ORACLE_USER=rm000000
ORACLE_PASSWORD=sua_senha
ORACLE_CONNECT_STRING=oracle.fiap.com.br:1521/ORCL

# Opcional: só se o banco exigir o modo "thick" (erro NJS-116/NJS-138)
# ORACLE_CLIENT_LIB=C:\oracle\instantclient_23_5
